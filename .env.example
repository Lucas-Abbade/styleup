# Copie para .env e preencha com os dados do seu projeto Supabase.
# Painel do Supabase > Project Settings > API
#
# Sem SUPABASE_URL e SUPABASE_ANON_KEY a API sobe em MODO DEMONSTRAÇÃO: dados em
# memória, login fictício e um guarda-roupa de exemplo. Serve para desenvolver o
# front e para apresentar sem depender de rede. Nunca liga com AMBIENTE=producao.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Só para projetos que ainda assinam o JWT com HS256 (Project Settings > API >
# JWT Settings > JWT Secret). Projetos com chaves assimétricas (ES256) não
# precisam: a API valida pelo JWKS público. NUNCA cole este valor em print,
# slide ou conversa — se vazar, troque no painel do Supabase.
SUPABASE_JWT_SECRET=

# Modelo de classificação zero-shot. O fallback automático é openai/clip-vit-base-patch32.
MODELO_CLIP=patrickjohncyh/fashion-clip

# Carrega rembg e FashionCLIP na subida da API, em segundo plano.
AQUECER_MODELOS=true

# Explicação por LLM é opcional; o modo template atende ao RNF14.
USAR_LLM=false

# Origens autorizadas a chamar a API (o frontend em desenvolvimento)
ORIGENS_PERMITIDAS=http://localhost:5173

# desenvolvimento | producao
AMBIENTE=desenvolvimento

# auto (liga quando o Supabase não está configurado) | true | false
MODO_DEMO=auto

# Versão do termo de consentimento em vigor (LGPD). Mudou o texto em
# backend/app/termo.py? Mude a versão: todos os usuários são consultados de novo.
VERSAO_TERMO=2026-11-v1
EXIGIR_CONSENTIMENTO=true
