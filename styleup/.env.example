# StyleUp — variáveis do backend.
#
# NADA AQUI É OBRIGATÓRIO PARA RODAR. Sem as chaves do Supabase a API sobe em
# modo demonstração, com dados em memória e guarda-roupa de exemplo. Preencha
# quando quiser ligar o Supabase de verdade.
#
# Painel do Supabase > Project Settings > API

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=

# Força o modo demonstração mesmo com o Supabase configurado. Útil para
# desenvolver o frontend sem sujar os dados reais.
MODO_DEMO=false

# Modelo de classificação zero-shot. O fallback automático é
# openai/clip-vit-base-patch32; sem torch instalado, a categoria vira palpite.
MODELO_CLIP=patrickjohncyh/fashion-clip

# Explicação por LLM é opcional; o modo template atende ao RNF14.
USAR_LLM=false

# Origens autorizadas a chamar a API (o frontend em desenvolvimento)
ORIGENS_PERMITIDAS=http://localhost:5173,http://127.0.0.1:5173

AMBIENTE=desenvolvimento
