# StyleUp — variáveis do frontend.
#
# NADA AQUI É OBRIGATÓRIO. Sem as chaves do Supabase o app roda em modo
# demonstração e conversa com a API local, que também está em memória.
# Copie para .env.local quando quiser ligar o Supabase.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Endereço da API. O padrão já é http://localhost:8000.
VITE_API_URL=http://localhost:8000
